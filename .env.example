APP_NAME="FEC v3"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# FEC legacy catalogue (freeextr_fec25), read-only during phase 0/1
FEC_DB_HOST=127.0.0.1
FEC_DB_PORT=3306
FEC_DB_DATABASE=freeextr_fec25
FEC_DB_USERNAME=
FEC_DB_PASSWORD=
FEC_DB_PREFIX=jos_
# writing user for click tracking (INSERT jos_bonus_clicks, UPDATE jos_shortlink)
FEC_RW_DB_USERNAME=
FEC_RW_DB_PASSWORD=

# goto.php (phase 1)
FEC_GOTO_PARAMS=link
FEC_GOTO_FALLBACK=/

# FEC v3 site settings (see config/fec.php)
FEC_SITE_URL=https://www.freeextrachips.com
FEC_ASSET_BASE=https://www.freeextrachips.com
FEC_CONTAINER_WIDTH=1200
FEC_GTM_ID=GTM-P4J6ZS

# Desk Lint (php artisan fec:desk-lint --probe to calibrate)
FEC_BONUS_ACTIVE_WHERE="status = 'active'"
FEC_BONUS_WELCOME_TYPES=su
FEC_BONUS_CURRENCIES=euro,usd,gbp,btc,mbtc,aud,cad,sek,nok,kr,nzd,usdt,dkk
FEC_DESK_LINT_STALE_DAYS=180
FEC_DESK_LINT_MAIL_TO=system@freeextrachips.com
FEC_DESK_LINT_RECAP_WEEKDAY=1
FEC_TG_BOT_TOKEN=
FEC_TG_DESK_CHAT_ID=
FEC_DESK_LINT_CURRENCY_BY_MARKET=true
FEC_DESK_LINT_CLOSED_FLAGS=blacklisted

# Legacy components on v3 (app/Fec/Legacy): Joomla's secret (newsletter signatures), the real docroot,
# the editions config of the snapshot tasks, and the switches that hand work over from Joomla to v3.
FEC_LEGACY_SECRET=
# Joomla's configuration.php sender (mailfrom/fromname): From of the legacy code's mails and
# com_partnerdesk's notification address; v3's own mails keep MAIL_FROM_*.
FEC_LEGACY_MAILFROM=
FEC_LEGACY_FROMNAME=
FEC_LEGACY_DOCROOT=/home/freeextr/public_html
FEC_LEGACY_EDITIONS_CONFIG=/home/freeextr/conf/fec_payout_index.php
FEC_LEGACY_SCHEDULE_SNAPSHOTS=false
FEC_LEGACY_SEF_REGISTER=false
# Crons moved from the crontab of freeextr (phase 5): its clock, and the jackpot update
# (com_jackpots data.update) with the crontab's expression; the jackpot tracker database.
FEC_LEGACY_CRON_TIMEZONE=America/New_York
FEC_LEGACY_SCHEDULE_JACKPOTS=false
FEC_JACKPOTS_UPDATE_CRON=
FEC_JPTEST_DATABASE=freeextr_jptest
# fec:legacy:cli (the weekly digest, llms.txt): PHP 5.6's date() zone, and their schedules.
FEC_LEGACY_PHP56_TIMEZONE=UTC
FEC_LEGACY_SCHEDULE_DIGEST=false
FEC_LEGACY_SCHEDULE_LLMSTXT=false
FEC_LEGACY_SCHEDULE_COFM=false
# The global metadata options of Joomla's configuration.php, read by the port of com_content
# (phase 4): the site's MetaDesc is the description of a page without one of its own;
# sitename_pagetitles 0/1/2 leaves, prefixes or suffixes the site name on every title.
FEC_LEGACY_META_DESCRIPTION=
FEC_LEGACY_META_KEYWORDS=
FEC_LEGACY_META_RIGHTS=
FEC_LEGACY_META_AUTHOR=0
FEC_LEGACY_META_ROBOTS=
FEC_LEGACY_SITENAME_PAGETITLES=0
# The review form of the casino pages: the public Turnstile site key (the one the live
# fec_review_config.php prints in the form) and the limits it announces.
FEC_TURNSTILE_SITE_KEY=
FEC_REVIEW_MIN_LENGTH=50
FEC_REVIEW_MAX_LENGTH=3000
FEC_REVIEW_MIN_SECONDS_ON_FORM=5
