<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="2.5" method="upgrade">
    <name>com_atlas</name>
    <author>FreeExtraChips Editorial Desk</author>
    <creationDate>2026-08-05</creationDate>
    <copyright>Copyright (C) 2026 FreeExtraChips.com. All rights reserved.</copyright>
    <license>Proprietary</license>
    <authorUrl>https://freeextrachips.com</authorUrl>
    <version>1.3.3</version>
    <description>
        FEC Operator Atlas - structured register of the legal entities behind
        casino brands. Phase 2 gated editorial dashboard plus Phase 3 public register views under /operators/.
        Install SQL is idempotent (CREATE TABLE IF NOT EXISTS): safe to install
        where the atlas tables already exist. No uninstall SQL by design - the
        Atlas data is never dropped by the installer.
    </description>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>

    <files folder="site">
        <filename>atlas.php</filename>
        <filename>controller.php</filename>
        <filename>router.php</filename>
        <filename>index.html</filename>
        <folder>assets</folder>
        <folder>controllers</folder>
        <folder>helpers</folder>
        <folder>models</folder>
        <folder>views</folder>
    </files>

    <administration>
        <menu img="class:component">Operator Atlas</menu>
        <files folder="admin">
            <filename>atlas.php</filename>
            <filename>index.html</filename>
            <folder>sql</folder>
        </files>
    </administration>
</extension>
